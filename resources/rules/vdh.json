{
  "rule_set": "vdh",
  "version": "1.0.0",
  "description": "Validation rules specific to Virginia Department of Health CSV data sources",
  "applies_to": ["vdh"],
  "source_id": "CSV",
  "rules": [
    {
      "rule_id": "vdh_001",
      "field": "locality",
      "check": "schema_presence",
      "params": {
        "required": true
      },
      "severity": "error",
      "on_fail_hint": "locality field is required; verify CSV column name matches expected schema"
    },
    {
      "rule_id": "vdh_002",
      "field": "locality",
      "check": "dtype_enforcement",
      "params": {
        "dtype": "string",
        "nullable": false
      },
      "severity": "error",
      "on_fail_hint": "Convert locality to string dtype"
    },
    {
      "rule_id": "vdh_003",
      "field": "fips_code",
      "check": "schema_presence",
      "params": {
        "required": true
      },
      "severity": "error",
      "on_fail_hint": "fips_code is required for geographic linkage; verify CSV schema"
    },
    {
      "rule_id": "vdh_004",
      "field": "fips_code",
      "check": "dtype_enforcement",
      "params": {
        "dtype": "string",
        "nullable": false,
        "note": "Keep as string to preserve leading zeros"
      },
      "severity": "error",
      "on_fail_hint": "Convert fips_code to string (not int) to preserve leading zeros"
    },
    {
      "rule_id": "vdh_005",
      "field": "fips_code",
      "check": "regex_pattern",
      "params": {
        "pattern": "^51\\d{3}$",
        "description": "Virginia FIPS codes start with 51"
      },
      "severity": "error",
      "on_fail_hint": "FIPS code must be 5-digit string starting with 51 (Virginia); check data source"
    },
    {
      "rule_id": "vdh_006",
      "field": "fips_code",
      "check": "enum_count",
      "params": {
        "expected_unique": 133,
        "description": "Virginia has 133 localities (95 counties + 38 cities)"
      },
      "severity": "warning",
      "on_fail_hint": "Expected 133 unique Virginia localities; verify data completeness or aggregation level"
    },
    {
      "rule_id": "vdh_007",
      "field": "year",
      "check": "schema_presence",
      "params": {
        "required": true
      },
      "severity": "error",
      "on_fail_hint": "year field is required for temporal derivation; check CSV column names"
    },
    {
      "rule_id": "vdh_008",
      "field": "year",
      "check": "dtype_enforcement",
      "params": {
        "dtype": "int64",
        "nullable": false
      },
      "severity": "error",
      "on_fail_hint": "Convert year to int64 dtype"
    },
    {
      "rule_id": "vdh_009",
      "field": "year",
      "check": "range_check",
      "params": {
        "min": 2015,
        "max": 2025
      },
      "severity": "warning",
      "on_fail_hint": "year outside expected range 2015-2025; verify data source time bounds"
    },
    {
      "rule_id": "vdh_010",
      "field": "month",
      "check": "dtype_enforcement",
      "params": {
        "dtype": "int64",
        "nullable": true,
        "note": "Month may be null for annual data"
      },
      "severity": "warning",
      "on_fail_hint": "Convert month to nullable int64; annual data will have null month"
    },
    {
      "rule_id": "vdh_011",
      "field": "month",
      "check": "range_check",
      "params": {
        "min": 1,
        "max": 12,
        "allow_null": true
      },
      "severity": "error",
      "on_fail_hint": "month must be 1-12 or null; invalid month values detected"
    },
    {
      "rule_id": "vdh_012",
      "field": "state_abbr",
      "check": "value_check",
      "params": {
        "expected_value": "VA",
        "after_transform": true
      },
      "severity": "error",
      "on_fail_hint": "All VDH records should have state_abbr='VA'; derivation logic failed"
    },
    {
      "rule_id": "vdh_013",
      "field": "period_id",
      "check": "consistency_check",
      "params": {
        "rule": "if month is null then period_id ends with '01' and low_precision_time is True"
      },
      "severity": "error",
      "on_fail_hint": "When month is null, period_id should be YYYY01 with low_precision_time=True"
    },
    {
      "rule_id": "vdh_014",
      "field": "period_id",
      "check": "consistency_check",
      "params": {
        "rule": "if month is not null then period_id == str(year) + str(month).zfill(2)"
      },
      "severity": "error",
      "on_fail_hint": "period_id should be YYYYMM when month is available; check derivation logic"
    },
    {
      "rule_id": "vdh_015",
      "field": "health_opportunity_index",
      "check": "range_check",
      "params": {
        "min": 0,
        "max": 100,
        "schema_variant": "vdh_hoi"
      },
      "severity": "error",
      "on_fail_hint": "Health Opportunity Index score must be 0-100; check data source or scaling"
    },
    {
      "rule_id": "vdh_016",
      "field": "education_score",
      "check": "range_check",
      "params": {
        "min": 0,
        "max": 100,
        "schema_variant": "vdh_hoi"
      },
      "severity": "error",
      "on_fail_hint": "Education score must be 0-100; verify HOI component scaling"
    },
    {
      "rule_id": "vdh_017",
      "field": "social_economic_score",
      "check": "range_check",
      "params": {
        "min": 0,
        "max": 100,
        "schema_variant": "vdh_hoi"
      },
      "severity": "error",
      "on_fail_hint": "Social/economic score must be 0-100; verify HOI component scaling"
    },
    {
      "rule_id": "vdh_018",
      "field": "population",
      "check": "range_check",
      "params": {
        "min": 1000,
        "max": 2000000,
        "schema_variant": "vdh_hoi"
      },
      "severity": "warning",
      "on_fail_hint": "Population outside typical VA locality range 1,000-2,000,000; verify data"
    },
    {
      "rule_id": "vdh_019",
      "field": "poverty_rate",
      "check": "range_check",
      "params": {
        "min": 0,
        "max": 100,
        "schema_variant": "vdh_hoi"
      },
      "severity": "error",
      "on_fail_hint": "Poverty rate must be 0-100%; check if value is decimal (0-1) and needs scaling"
    },
    {
      "rule_id": "vdh_020",
      "field": "total_participants",
      "check": "range_check",
      "params": {
        "min": 0,
        "max": 50000,
        "schema_variant": "vdh_wic"
      },
      "severity": "warning",
      "on_fail_hint": "WIC total participants outside expected range 0-50,000; verify locality size or data quality"
    },
    {
      "rule_id": "vdh_021",
      "field": "total_participants",
      "check": "consistency_check",
      "params": {
        "rule": "total_participants >= (women_participants + infants_participants + children_participants)",
        "schema_variant": "vdh_wic",
        "allow_null": true
      },
      "severity": "warning",
      "on_fail_hint": "WIC total participants should equal or exceed sum of category counts; check for data quality issues"
    },
    {
      "rule_id": "vdh_022",
      "field": "women_participants",
      "check": "range_check",
      "params": {
        "min": 0,
        "max": 10000,
        "schema_variant": "vdh_wic"
      },
      "severity": "warning",
      "on_fail_hint": "WIC women participants outside expected range; verify data quality"
    },
    {
      "rule_id": "vdh_023",
      "field": "*",
      "check": "suppression_check",
      "params": {
        "rule": "small_count_suppression",
        "threshold": 5,
        "note": "VDH may suppress counts < 5 for privacy"
      },
      "severity": "info",
      "on_fail_hint": "Small counts may be suppressed or null for privacy protection; this is expected"
    },
    {
      "rule_id": "vdh_024",
      "field": "ambiguous_geo",
      "check": "value_check",
      "params": {
        "expected_value": false,
        "reason": "VDH data has explicit Virginia locality identifiers"
      },
      "severity": "warning",
      "on_fail_hint": "VDH data should have ambiguous_geo=False (explicit geography); unexpected if True"
    },
    {
      "rule_id": "vdh_025",
      "field": "nih_geo_limited",
      "check": "value_check",
      "params": {
        "expected_value": false,
        "reason": "VDH is not NIH data"
      },
      "severity": "error",
      "on_fail_hint": "nih_geo_limited should be False for VDH; this flag is NIH-specific"
    }
  ],
  "schema_variant_rules": {
    "vdh_hoi": {
      "required_fields": [
        "locality", "fips_code", "year", "health_opportunity_index",
        "education_score", "social_economic_score", "population"
      ],
      "score_fields": [
        "health_opportunity_index", "education_score", "social_economic_score",
        "physical_environment_score", "community_safety_score"
      ],
      "score_range": [0, 100]
    },
    "vdh_wic": {
      "required_fields": [
        "locality", "fips_code", "year", "total_participants"
      ],
      "participant_fields": [
        "women_participants", "infants_participants", "children_participants"
      ],
      "temporal_granularity": "monthly_or_annual"
    }
  },
  "data_quality_notes": [
    {
      "note": "VDH data may have suppressed counts for small localities to protect privacy",
      "severity": "info"
    },
    {
      "note": "Month field may be null for annual aggregations; set low_precision_time flag",
      "severity": "info"
    },
    {
      "note": "FIPS codes must be preserved as strings to maintain leading zeros (e.g., 51001)",
      "severity": "warning"
    },
    {
      "note": "All VDH data is inherently Virginia-specific; state_abbr should always be 'VA'",
      "severity": "info"
    }
  ]
}
