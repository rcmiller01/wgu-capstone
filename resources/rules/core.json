{
  "rule_set": "core",
  "version": "1.0.0",
  "description": "Core validation rules applicable to all data sources after cleaning and transformation",
  "applies_to": ["synthea", "vdh", "nhanes", "nih"],
  "rules": [
    {
      "rule_id": "core_001",
      "field": "state_abbr",
      "check": "schema_presence",
      "params": {
        "required": true
      },
      "severity": "error",
      "on_fail_hint": "state_abbr is a required key field; ensure geographic derivation logic executed"
    },
    {
      "rule_id": "core_002",
      "field": "state_abbr",
      "check": "dtype_enforcement",
      "params": {
        "dtype": "category",
        "nullable": false
      },
      "severity": "error",
      "on_fail_hint": "Convert state_abbr to pandas categorical dtype"
    },
    {
      "rule_id": "core_003",
      "field": "state_abbr",
      "check": "enum_check",
      "params": {
        "allowed_values": [
          "VA", "AL", "AK", "AZ", "AR", "CA", "CO", "CT", "DE", "FL", "GA",
          "HI", "ID", "IL", "IN", "IA", "KS", "KY", "LA", "ME", "MD", "MA",
          "MI", "MN", "MS", "MO", "MT", "NE", "NV", "NH", "NJ", "NM", "NY",
          "NC", "ND", "OH", "OK", "OR", "PA", "RI", "SC", "SD", "TN", "TX",
          "UT", "VT", "WA", "WV", "WI", "WY", "DC", "UNKNOWN"
        ]
      },
      "severity": "error",
      "on_fail_hint": "state_abbr must be valid 2-letter US state code or 'UNKNOWN'; check geographic derivation logic"
    },
    {
      "rule_id": "core_004",
      "field": "period_id",
      "check": "schema_presence",
      "params": {
        "required": true
      },
      "severity": "error",
      "on_fail_hint": "period_id is a required key field; ensure temporal derivation logic executed"
    },
    {
      "rule_id": "core_005",
      "field": "period_id",
      "check": "dtype_enforcement",
      "params": {
        "dtype": "string",
        "nullable": false
      },
      "severity": "error",
      "on_fail_hint": "Convert period_id to string dtype in YYYYMM format"
    },
    {
      "rule_id": "core_006",
      "field": "period_id",
      "check": "regex_pattern",
      "params": {
        "pattern": "^\\d{6}$|^UNKNOWN$",
        "description": "YYYYMM format (6 digits) or 'UNKNOWN'"
      },
      "severity": "error",
      "on_fail_hint": "period_id must be 6-digit YYYYMM string or 'UNKNOWN'; check date truncation logic"
    },
    {
      "rule_id": "core_007",
      "field": "period_id",
      "check": "date_bounds",
      "params": {
        "min_date": "201501",
        "max_date": "202512",
        "allow_unknown": true
      },
      "severity": "warning",
      "on_fail_hint": "period_id outside expected range 2015-2025; verify data source time bounds"
    },
    {
      "rule_id": "core_008",
      "field": "source_id",
      "check": "schema_presence",
      "params": {
        "required": true
      },
      "severity": "error",
      "on_fail_hint": "source_id is required; must be set during ETL"
    },
    {
      "rule_id": "core_009",
      "field": "source_id",
      "check": "dtype_enforcement",
      "params": {
        "dtype": "category",
        "nullable": false
      },
      "severity": "error",
      "on_fail_hint": "Convert source_id to pandas categorical dtype"
    },
    {
      "rule_id": "core_010",
      "field": "source_id",
      "check": "enum_check",
      "params": {
        "allowed_values": ["CSV", "FHIR", "HL7", "IMG_META"]
      },
      "severity": "error",
      "on_fail_hint": "source_id must be CSV|FHIR|HL7|IMG_META; check source mapping in join_spec.json"
    },
    {
      "rule_id": "core_011",
      "field": "schema_variant",
      "check": "schema_presence",
      "params": {
        "required": true
      },
      "severity": "error",
      "on_fail_hint": "schema_variant is required; must be set to source-specific tag"
    },
    {
      "rule_id": "core_012",
      "field": "schema_variant",
      "check": "dtype_enforcement",
      "params": {
        "dtype": "category",
        "nullable": false
      },
      "severity": "error",
      "on_fail_hint": "Convert schema_variant to pandas categorical dtype"
    },
    {
      "rule_id": "core_013",
      "field": "low_precision_time",
      "check": "schema_presence",
      "params": {
        "required": true
      },
      "severity": "error",
      "on_fail_hint": "low_precision_time flag must be present; set to True if only year available, else False"
    },
    {
      "rule_id": "core_014",
      "field": "low_precision_time",
      "check": "dtype_enforcement",
      "params": {
        "dtype": "boolean",
        "nullable": false
      },
      "severity": "error",
      "on_fail_hint": "Convert low_precision_time to boolean dtype"
    },
    {
      "rule_id": "core_015",
      "field": "ambiguous_geo",
      "check": "schema_presence",
      "params": {
        "required": true
      },
      "severity": "error",
      "on_fail_hint": "ambiguous_geo flag must be present; set to True if state not confidently resolved, else False"
    },
    {
      "rule_id": "core_016",
      "field": "ambiguous_geo",
      "check": "dtype_enforcement",
      "params": {
        "dtype": "boolean",
        "nullable": false
      },
      "severity": "error",
      "on_fail_hint": "Convert ambiguous_geo to boolean dtype"
    },
    {
      "rule_id": "core_017",
      "field": "nih_geo_limited",
      "check": "schema_presence",
      "params": {
        "required": true
      },
      "severity": "warning",
      "on_fail_hint": "nih_geo_limited flag should be present; set to True for NIH data, False otherwise"
    },
    {
      "rule_id": "core_018",
      "field": "nih_geo_limited",
      "check": "dtype_enforcement",
      "params": {
        "dtype": "boolean",
        "nullable": false
      },
      "severity": "warning",
      "on_fail_hint": "Convert nih_geo_limited to boolean dtype"
    },
    {
      "rule_id": "core_019",
      "field": "*",
      "check": "consistency_check",
      "params": {
        "rule": "if state_abbr == 'UNKNOWN' then ambiguous_geo must be True"
      },
      "severity": "warning",
      "on_fail_hint": "When state cannot be determined, both state_abbr='UNKNOWN' and ambiguous_geo=True should be set"
    },
    {
      "rule_id": "core_020",
      "field": "*",
      "check": "consistency_check",
      "params": {
        "rule": "if period_id == 'UNKNOWN' then low_precision_time must be True"
      },
      "severity": "warning",
      "on_fail_hint": "When temporal data is unavailable, both period_id='UNKNOWN' and low_precision_time=True should be set"
    },
    {
      "rule_id": "core_021",
      "field": "*",
      "check": "consistency_check",
      "params": {
        "rule": "if source_id == 'IMG_META' then nih_geo_limited should be True"
      },
      "severity": "info",
      "on_fail_hint": "NIH image metadata (IMG_META) typically lacks geography; nih_geo_limited should be True"
    },
    {
      "rule_id": "core_022",
      "field": "period_id",
      "check": "date_logic_check",
      "params": {
        "rule": "YYYY portion must be <= current_year + 1"
      },
      "severity": "warning",
      "on_fail_hint": "Future dates detected; verify data source time range or check for data entry errors"
    },
    {
      "rule_id": "core_023",
      "field": "period_id",
      "check": "date_logic_check",
      "params": {
        "rule": "MM portion must be 01-12"
      },
      "severity": "error",
      "on_fail_hint": "Invalid month in period_id; must be 01-12"
    }
  ],
  "flag_consistency_rules": [
    {
      "rule_id": "flag_001",
      "description": "Validate flag combinations",
      "checks": [
        {
          "condition": "state_abbr == 'VA' and ambiguous_geo == True",
          "severity": "warning",
          "message": "VA state with ambiguous_geo=True is contradictory; review derivation"
        },
        {
          "condition": "source_id == 'FHIR' and nih_geo_limited == True",
          "severity": "warning",
          "message": "FHIR data (Synthea) should not have nih_geo_limited flag; this is NIH-specific"
        },
        {
          "condition": "low_precision_time == False and period_id matches ^\\d{4}01$",
          "severity": "info",
          "message": "Period ending in 01 may indicate year-only data; verify low_precision_time flag"
        }
      ]
    }
  ],
  "post_aggregation_rules": [
    {
      "rule_id": "agg_001",
      "field": "state_abbr",
      "check": "grain_validation",
      "params": {
        "grain": ["state_abbr", "period_id"],
        "allow_duplicates": false
      },
      "severity": "error",
      "on_fail_hint": "Duplicate state_abbr × period_id combinations detected; aggregation failed"
    },
    {
      "rule_id": "agg_002",
      "field": "*",
      "check": "completeness_check",
      "params": {
        "expected_state_count": 1,
        "expected_state": "VA",
        "min_periods": 12
      },
      "severity": "warning",
      "on_fail_hint": "Expected at least 12 monthly periods for VA; check data coverage"
    }
  ]
}
